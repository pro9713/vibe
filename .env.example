# Pricely Environment Configuration Example
# Copy this file to .env.local and add your real credentials.
# NEVER commit your real API keys to version control.

# QuickCommerce API Authentication
# Server-side only (never prefix with NEXT_PUBLIC_)
QUICKCOMMERCE_API_KEY=

# Active Product Data Provider: "local" (default) | "quickcommerce"
DATA_PROVIDER=local

# Server-side Cache TTL in seconds for QuickCommerce API responses (to preserve credits)
QUICKCOMMERCE_CACHE_SECONDS=60
